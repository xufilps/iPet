root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{md,txt}]
trim_trailing_whitespace = false

[*.{yml,yaml,json,sh}]
indent_size = 2

# Upstream evidence and assets preserve their original bytes.
[docs/upstream/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

[Assets/Upstream/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

# LICENSE is an unmodified original.
[LICENSE]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
